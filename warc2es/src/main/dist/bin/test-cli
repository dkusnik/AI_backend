#!/usr/bin/env bash
# test-cli - Enterprise Test Launcher
# Specification: docs/adr/A-GUIDELINES-testing.md

set -euo pipefail

# === Environment ===
# Anchor to script's own directory (absolute) so all relative paths are stable
# regardless of where the user invoked test-cli from.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pushd "$SCRIPT_DIR" > /dev/null
# Look for PROJECT_ROOT by finding pom.xml
FIND_ROOT="$(pwd)"
while [[ "$FIND_ROOT" != "/" && ! -f "$FIND_ROOT/pom.xml" ]]; do
    FIND_ROOT="$(dirname "$FIND_ROOT")"
done
PROJECT_ROOT="$FIND_ROOT"

SCRIPTS_BASE_DIR="$SCRIPT_DIR/../testing/scripts"
RESULTS_DIR="$PROJECT_ROOT/target/testing/tmp/results"
REPORTS_DIR="$PROJECT_ROOT/target/testing/tmp/reports"
ETA_DIR="$PROJECT_ROOT/target/testing/tmp/test-eta"
JFR_DIR="$PROJECT_ROOT/target/testing/tmp/jfr"
TMP_WORK_DIR="$PROJECT_ROOT/target/testing/tmp/work"

DIST_ROOT="${DIST_ROOT:-$PROJECT_ROOT/target/dist}"
BIN_DIR="$DIST_ROOT/bin"
export DIST_ROOT
export PATH="$BIN_DIR:$PATH"

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
DATE_DIR=$(date +%Y%m%d)
CURRENT_RESULTS_DIR="$RESULTS_DIR/$DATE_DIR/$TIMESTAMP"
mkdir -p "$CURRENT_RESULTS_DIR" "$RESULTS_DIR/history" "$REPORTS_DIR" "$ETA_DIR" "$JFR_DIR" "$TMP_WORK_DIR"

# Defaults
PARALLEL=1
BENCHMARK=false
JFR=false
PROFILE="limits-med"
BLACK_BOX=false
PRESET="slow"
SUITE_MAX_SECONDS=0
PER_TEST_TIMEOUT_CAP=0
PRINT_TIMEOUT=false

MODULE_BENCH_REPORT="$CURRENT_RESULTS_DIR/module_bench.tsv"

# === Colors & Interaction ===
INTERACTIVE=false
[[ -t 1 ]] && INTERACTIVE=true
[[ -n "${NO_COLOR:-}" ]] && INTERACTIVE=false
[[ -n "${FORCE_COLOR:-}" ]] && INTERACTIVE=true

if [[ "$INTERACTIVE" == "true" ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

log() {
    echo -e "${BLUE}[test-cli]${NC} $1"
}
export -f log

usage() {
    echo "Usage: ./test-cli [options] <target1> [target2] ..."
    echo ""
    echo "Options:"
    echo "  --parallel=N       Run N tests in parallel (default: 1)"
    echo "  --benchmark        Enable benchmarking mode"
    echo "  --jfr              Enable JFR profiling"
    echo "  --profile=P        Resource profile (limits-low, limits-med, limits-high)"
    echo "  --preset=P         Execution preset: flash | fast | slow | benchmark"
    echo "  --print-timeout    Print resolved timeout for selected tests and exit"
    echo ""
    echo "Preset budgets:"
    echo "  flash      20s suite max, 20s per-test cap"
    echo "  fast       300s suite max"
    echo "  slow       no suite cap"
    echo "  benchmark  benchmark-only behavior + reproducible output mode"
    echo ""
    echo "Special targets:"
    echo "  full         Run every registered non-benchmark, non-red test"
    echo "  red          Run every registered red test"
    echo "  es           Run every registered test tagged with 'es'"
    echo "  golden       Run golden-path multi-stage integration scenarios"
    echo "  module-bench Run all bench-module-*.sh benchmarks"
    exit 1
}

REGISTRY_FILE="$SCRIPT_DIR/../testing/registry.yaml"
REGISTRY_ROWS=()

load_registry_rows() {
    REGISTRY_ROWS=()
    [[ -f "$REGISTRY_FILE" ]] || return 0

    mapfile -t REGISTRY_ROWS < <(awk '
      function flush() {
        if (id != "" && scope != "" && script != "") {
          gsub(/[[:space:]]/, "", tags)
          print id "|" scope "|" script "|" tags
        }
      }
      /^[[:space:]]*-[[:space:]]+id:[[:space:]]*/ {
        flush()
        id=$0
        sub(/^[[:space:]]*-[[:space:]]+id:[[:space:]]*/, "", id)
        gsub(/^["'\'']|["'\'']$/, "", id)
        scope=""; script=""; tags=""
      }
      /^[[:space:]]*scope:[[:space:]]*/ {
        scope=$0
        sub(/^[[:space:]]*scope:[[:space:]]*/, "", scope)
        gsub(/^["'\'']|["'\'']$/, "", scope)
      }
      /^[[:space:]]*script:[[:space:]]*/ {
        script=$0
        sub(/^[[:space:]]*script:[[:space:]]*/, "", script)
        gsub(/^["'\'']|["'\'']$/, "", script)
      }
      /^[[:space:]]*tags:[[:space:]]*\[/ {
        tags=$0
        sub(/^[[:space:]]*tags:[[:space:]]*\[/, "", tags)
        sub(/\][[:space:]]*$/, "", tags)
      }
      END { flush() }
    ' "$REGISTRY_FILE")
}

target_matches_registry_row() {
    local target="$1"
    local row="$2"
    local id scope script tags

    IFS='|' read -r id scope script tags <<< "$row"
    [[ -z "$id" || -z "$scope" || -z "$script" ]] && return 1

    [[ "$target" == "$id" ]] && return 0

    if [[ "$scope" == "$target" || "$scope" == "$target/"* ]]; then
        return 0
    fi

    [[ "$script" == "$target" || "$script" == "$target.sh" ]] && return 0

    local base
    base="$(basename "$script")"
    [[ "$base" == "$target" || "${base%.sh}" == "$target" ]] && return 0

    if [[ -n "${tags:-}" ]]; then
        local tag_csv=",${tags},"
        if [[ "$tag_csv" == *",${target},"* ]]; then
            return 0
        fi
    fi

    return 1
}

declare -a DISCOVERY_SKIP_LINES=()

record_discovery_skip() {
    local script_path="$1"
    local reason="$2"
    local test_id
    test_id=$(test_id_for_script "$script_path")
    local provenance
    provenance=$(infer_provenance "$script_path")
    DISCOVERY_SKIP_LINES+=("[ SKIP ][${provenance}] ${test_id} (${reason})")
}

add_tests_for_target() {
    local target="$1"
    local matched=0

    if [[ -f "$SCRIPTS_BASE_DIR/$target" ]]; then
        TEST_LIST+=("$SCRIPTS_BASE_DIR/$target")
        return 0
    fi

    if [[ "$target" == "full" ]]; then
        local row script id
        for row in "${REGISTRY_ROWS[@]}"; do
            IFS='|' read -r id _ script _ <<< "$row"
            [[ -z "$script" ]] && continue
            script="${script#./}"
            script="${script#scripts/}"
            local full_path="$SCRIPTS_BASE_DIR/$script"
            if is_benchmark_script "$full_path"; then
                SKIP_REASON_DISCOVERY["benchmark-excluded"]=$(( ${SKIP_REASON_DISCOVERY["benchmark-excluded"]:-0} + 1 ))
                record_discovery_skip "$full_path" "reason=benchmark-excluded"
                continue
            fi
            if [[ "$full_path" == *"/red/"* ]]; then
                SKIP_REASON_DISCOVERY["red-excluded"]=$(( ${SKIP_REASON_DISCOVERY["red-excluded"]:-0} + 1 ))
                record_discovery_skip "$full_path" "reason=red-excluded"
                continue
            fi
            TEST_LIST+=("$full_path")
            matched=1
        done
        [[ "$matched" -eq 1 ]] && return 0
    fi

    if [[ "$target" == "red" ]]; then
        local row script
        for row in "${REGISTRY_ROWS[@]}"; do
            IFS='|' read -r _ scope script _ <<< "$row"
            [[ -z "$script" ]] && continue
            script="${script#./}"
            script="${script#scripts/}"
            local full_path="$SCRIPTS_BASE_DIR/$script"
            if [[ "$scope" == "red" || "$full_path" == *"/red/"* ]]; then
                TEST_LIST+=("$full_path")
                matched=1
            fi
        done
        [[ "$matched" -eq 1 ]] && return 0
    fi

    if [[ "$target" == "module-bench" ]]; then
        while IFS= read -r -d '' file; do
            TEST_LIST+=("$file")
            matched=1
        done < <(find "$SCRIPTS_BASE_DIR" -type f -name "bench-module-*.sh" -print0)
        [[ "$matched" -eq 1 ]] && return 0
    fi

    local row id scope script
    for row in "${REGISTRY_ROWS[@]}"; do
        if target_matches_registry_row "$target" "$row"; then
            IFS='|' read -r id scope script _ <<< "$row"
            script="${script#./}"
            script="${script#scripts/}"
            TEST_LIST+=("$SCRIPTS_BASE_DIR/$script")
            matched=1
        fi
    done

    if [[ "$matched" -eq 0 && "$target" == */* ]]; then
        while IFS= read -r -d '' file; do
            TEST_LIST+=("$file")
            matched=1
        done < <(find "$SCRIPTS_BASE_DIR" -type f -name "*.sh" -path "*/$target/*" -print0)
    fi

    return 0
}

apply_preset() {
    case "$PRESET" in
        flash)
            SUITE_MAX_SECONDS=20
            PER_TEST_TIMEOUT_CAP=20
            ;;
        fast)
            SUITE_MAX_SECONDS=300
            PER_TEST_TIMEOUT_CAP=0
            ;;
        slow)
            SUITE_MAX_SECONDS=0
            PER_TEST_TIMEOUT_CAP=0
            ;;
        benchmark)
            SUITE_MAX_SECONDS=0
            PER_TEST_TIMEOUT_CAP=0
            BENCHMARK=true
            PARALLEL=1
            ;;
        *)
            echo "Unknown preset: $PRESET" >&2
            exit 1
            ;;
    esac
}

get_eta() {
    local test_id="$1"
    local eta_file="$ETA_DIR/${test_id}.eta"
    if [[ -f "$eta_file" ]]; then
        tail -n 5 "$eta_file" | awk '{ sum += $1; n++ } END { if (n > 0) print sum / n; else print 10 }'
    else
        echo "10"
    fi
}

record_eta() {
    local test_id="$1"
    local elapsed="$2"
    local eta_file="$ETA_DIR/${test_id}.eta"
    echo "$elapsed" >> "$eta_file"
    tail -n 5 "$eta_file" > "${eta_file}.tmp" && mv "${eta_file}.tmp" "$eta_file"
}

format_duration() {
    local seconds="${1%.*}"
    [[ -z "$seconds" ]] && seconds=0
    printf "%02d:%02d" $((seconds / 60)) $((seconds % 60))
}

test_id_for_script() {
    local script_path="$1"
    local rel="${script_path#"$SCRIPTS_BASE_DIR"/}"
    rel="${rel%.sh}"
    echo "${rel//\//__}"
}

is_benchmark_script() {
    local script_path="$1"
    local base
    base=$(basename "$script_path")
    [[ "$script_path" == *"/bench/"* || "$script_path" == *"/benchmark/"* || "$base" == bench-* ]]
}

extract_pipeline_refs() {
    local script_path="$1"

    {
        sed -nE 's/.*run_pipeline[[:space:]]+"?([a-zA-Z0-9._-]+)"?.*/\1/p' "$script_path"
        sed -nE 's/.*\$PIPELINE_BIN[[:space:]]+"?([a-zA-Z0-9._-]+)"?.*/\1/p' "$script_path"
        sed -nE 's/.*\$CLI[[:space:]]+"?([a-zA-Z0-9._-]+)"?.*/\1/p' "$script_path"
        sed -nE 's/.*\$BIN_DIR\/pipeline-direct[[:space:]]+"?([a-zA-Z0-9._-]+)"?.*/\1/p' "$script_path"
    } | sort -u
}

load_production_pipelines() {
    local files=("$PROJECT_ROOT/src/main/dist/bin/warc-cli" "$PROJECT_ROOT/src/main/dist/bin/es-cli")
    PRODUCTION_PIPELINES=()

    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        while IFS= read -r p; do
            [[ -n "$p" ]] && PRODUCTION_PIPELINES+=("$p")
        done < <(sed -nE 's/.*run_pipeline[[:space:]]+"?([a-zA-Z0-9._-]+)"?.*/\1/p' "$f")
    done

    if [[ ${#PRODUCTION_PIPELINES[@]} -eq 0 ]]; then
        return
    fi

    mapfile -t PRODUCTION_PIPELINES < <(printf '%s\n' "${PRODUCTION_PIPELINES[@]}" | sort -u)
}

is_production_pipeline() {
    local candidate="$1"
    local p
    for p in "${PRODUCTION_PIPELINES[@]:-}"; do
        [[ "$candidate" == "$p" ]] && return 0
    done
    return 1
}

validate_pipeline_prefixes() {
    local failed=0
    local script_path
    local refs
    local ref

    for script_path in "${TEST_LIST[@]}"; do
        refs=$(extract_pipeline_refs "$script_path" || true)
        [[ -z "$refs" ]] && continue

        while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            if is_production_pipeline "$ref"; then
                continue
            fi

            if is_benchmark_script "$script_path"; then
                if [[ "$ref" != bench-* ]]; then
                    echo "PREFIX-LINT: benchmark script '$script_path' uses non-production pipeline '$ref' without 'bench-' prefix" >&2
                    failed=1
                fi
            else
                if [[ "$ref" != test-* ]]; then
                    echo "PREFIX-LINT: test script '$script_path' uses non-production pipeline '$ref' without 'test-' prefix" >&2
                    failed=1
                fi
            fi
        done <<< "$refs"
    done

    return $failed
}

infer_provenance() {
    local script_path="$1"
    local refs
    local ref
    local synthetic=0
    local bench=0
    local test=0

    refs=$(extract_pipeline_refs "$script_path" || true)
    if [[ -z "$refs" ]]; then
        echo "actual"
        return
    fi

    while IFS= read -r ref; do
        [[ -z "$ref" ]] && continue
        if is_production_pipeline "$ref"; then
            continue
        fi
        synthetic=1
        if [[ "$ref" == bench-* ]]; then
            bench=1
        elif [[ "$ref" == test-* ]]; then
            test=1
        fi
    done <<< "$refs"

    if [[ "$synthetic" -eq 0 ]]; then
        echo "actual"
    elif [[ "$bench" -eq 1 && "$test" -eq 0 ]]; then
        echo "bench"
    elif [[ "$test" -eq 1 && "$bench" -eq 0 ]]; then
        echo "test"
    else
        echo "mixed"
    fi
}

collect_case_json() {
    local output_file="$1"
    local fallback_status="$2"

    local cases_tmp
    cases_tmp=$(mktemp "$TMP_WORK_DIR/test-cli-cases.XXXXXX")

    while IFS= read -r line; do
        if [[ "$line" =~ ^TESTCASE\|([^|]+)\|(PASS|FAIL|SKIP)(\|(.*))?$ ]]; then
            local name="${BASH_REMATCH[1]}"
            local status="${BASH_REMATCH[2]}"
            local detail="${BASH_REMATCH[4]:-}"
            jq -nc --arg n "$name" --arg s "$status" --arg d "$detail" '{name:$n,status:$s,detail:$d}' >> "$cases_tmp"
        elif [[ "$line" =~ ^TESTCASE:[[:space:]]*([^:]+):[[:space:]]*(PASS|FAIL|SKIP)(:[[:space:]]*(.*))?$ ]]; then
            local name2="${BASH_REMATCH[1]}"
            local status2="${BASH_REMATCH[2]}"
            local detail2="${BASH_REMATCH[4]:-}"
            jq -nc --arg n "$name2" --arg s "$status2" --arg d "$detail2" '{name:$n,status:$s,detail:$d}' >> "$cases_tmp"
        fi
    done < "$output_file"

    if [[ ! -s "$cases_tmp" ]]; then
        jq -nc --arg s "$fallback_status" '[{name:"script",status:$s,detail:""}]'
    else
        jq -s '.' "$cases_tmp"
    fi

    rm -f "$cases_tmp"
}

collect_module_bench_lines() {
    local script_path="$1"
    local output_file="$2"
    while IFS= read -r line; do
        if [[ "$line" =~ ^MODULE_BENCH\|([^|]+)\|([^|]+)(\|([^|]+))?$ ]]; then
            local module="${BASH_REMATCH[1]}"
            local value="${BASH_REMATCH[2]}"
            local unit="${BASH_REMATCH[4]:-ops/s}"
            printf "%s\t%s\t%s\t%s\n" "$(basename "$script_path")" "$module" "$value" "$unit" >> "$MODULE_BENCH_REPORT"
        fi
    done < "$output_file"
}

export -f get_eta format_duration test_id_for_script record_eta collect_case_json collect_module_bench_lines
export SCRIPTS_BASE_DIR RESULTS_DIR REPORTS_DIR ETA_DIR CURRENT_RESULTS_DIR BLACK_BOX BENCHMARK GREEN RED NC DATE_DIR BLUE MODULE_BENCH_REPORT TMP_WORK_DIR

run_script_internal() {
    local script_path="$1"
    local test_id="$2"
    local runs="$3"
    local provenance="$4"

    local timeout_val
    timeout_val=$( (grep '^# @timeout:' "$script_path" || true) | cut -d':' -f2- | sed 's/[^0-9]//g')
    [[ -z "$timeout_val" ]] && timeout_val=60

    if [[ "$PER_TEST_TIMEOUT_CAP" -gt 0 && "$timeout_val" -gt "$PER_TEST_TIMEOUT_CAP" ]]; then
        timeout_val="$PER_TEST_TIMEOUT_CAP"
    fi

    local -a cmd_args=()
    if [[ "$BLACK_BOX" == "false" ]]; then
        cmd_args=(--debug --debug-cli-inline)
    fi
    if [[ "$BENCHMARK" == "true" ]]; then
        cmd_args=(--silent --benchmark)
    fi

    local results_collected=()
    local run_metrics_tmp
    run_metrics_tmp=$(mktemp "$TMP_WORK_DIR/test-cli-run-metrics.XXXXXX")
    local exit_code=0

    for (( i=1; i<=runs; i++ )); do
        if [[ "$BENCHMARK" == "true" && "$i" -eq 1 && "$runs" -gt 1 ]]; then
            timeout "${timeout_val}s" bash "$script_path" "${cmd_args[@]}" > /dev/null 2>&1 || true
        fi

        local output_file
        output_file=$(mktemp "$TMP_WORK_DIR/test-cli-output.XXXXXX")
        local time_file
        time_file=$(mktemp "$TMP_WORK_DIR/test-cli-time.XXXXXX")

        if command -v /usr/bin/time >/dev/null 2>&1; then
            set +e
            /usr/bin/time -f 'TIME_ELAPSED=%e\nTIME_CPU=%P\nTIME_RSS_KB=%M' -o "$time_file" \
                timeout "${timeout_val}s" bash "$script_path" "${cmd_args[@]}" > "$output_file" 2>&1
            exit_code=$?
            set -e
        else
            local start_epoch
            start_epoch=$(date +%s.%N)
            set +e
            timeout "${timeout_val}s" bash "$script_path" "${cmd_args[@]}" > "$output_file" 2>&1
            exit_code=$?
            set -e
            local end_epoch
            end_epoch=$(date +%s.%N)
            local elapsed
            elapsed=$(echo "$end_epoch - $start_epoch" | bc)
            printf 'TIME_ELAPSED=%s\nTIME_CPU=na\nTIME_RSS_KB=na\n' "$elapsed" > "$time_file"
        fi

        local elapsed_s cpu_pct max_rss_kb
        elapsed_s=$(grep '^TIME_ELAPSED=' "$time_file" | cut -d'=' -f2)
        cpu_pct=$(grep '^TIME_CPU=' "$time_file" | cut -d'=' -f2)
        max_rss_kb=$(grep '^TIME_RSS_KB=' "$time_file" | cut -d'=' -f2)
        [[ -z "$elapsed_s" ]] && elapsed_s=0
        [[ -z "$cpu_pct" ]] && cpu_pct="na"
        [[ -z "$max_rss_kb" ]] && max_rss_kb="na"

        local last_line
        last_line=$(tail -n 1 "$output_file" 2>/dev/null || true)
        results_collected+=("$last_line")

        collect_module_bench_lines "$script_path" "$output_file"
        local case_json
        case_json=$(collect_case_json "$output_file" "$([[ $exit_code -eq 0 ]] && echo PASS || echo FAIL)")

        jq -nc \
          --arg run "$i" \
          --arg elapsed_s "$elapsed_s" \
          --arg cpu "$cpu_pct" \
          --arg rss "$max_rss_kb" \
          --argjson cases "$case_json" \
          '{run:($run|tonumber), elapsed_s:($elapsed_s|tonumber), cpu_pct:$cpu, max_rss_kb:$rss, cases:$cases}' >> "$run_metrics_tmp"

        if [[ "$exit_code" -ne 0 ]]; then
            echo "FAIL: $test_id run $i (exit $exit_code)" >> "$CURRENT_RESULTS_DIR/errors.log"
            cat "$output_file" >> "$CURRENT_RESULTS_DIR/errors.log"
            rm -f "$time_file" "$output_file"
            break
        fi

        rm -f "$time_file" "$output_file"
    done

    local runs_json
    runs_json=$(jq -s '.' "$run_metrics_tmp")
    local avg_elapsed
    avg_elapsed=$(jq -s -r '[.[].elapsed_s] | if length==0 then 0 else (add/length) end' "$run_metrics_tmp")
    local case_total case_pass case_fail case_skip
    case_total=$(jq -s -r '[.[].cases[]] | length' "$run_metrics_tmp")
    case_pass=$(jq -s -r '[.[].cases[] | select(.status=="PASS")] | length' "$run_metrics_tmp")
    case_fail=$(jq -s -r '[.[].cases[] | select(.status=="FAIL")] | length' "$run_metrics_tmp")
    case_skip=$(jq -s -r '[.[].cases[] | select(.status=="SKIP")] | length' "$run_metrics_tmp")

    local script_status="OK"
    if [[ "$exit_code" -ne 0 ]]; then
        script_status="NOK"
    elif [[ "$case_total" -gt 0 && "$case_pass" -eq 0 && "$case_fail" -eq 0 && "$case_skip" -gt 0 ]]; then
        script_status="SKIP"
    fi

    local json_file="$CURRENT_RESULTS_DIR/${test_id}.json"
    jq -nc \
      --arg test_id "$test_id" \
      --arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg status "$script_status" \
      --arg provenance "$provenance" \
      --arg detail "${results_collected[*]}" \
      --arg avg_elapsed "$avg_elapsed" \
      --argjson runs "$runs_json" \
      --arg case_total "$case_total" \
      --arg case_pass "$case_pass" \
      --arg case_fail "$case_fail" \
      --arg case_skip "$case_skip" \
      '{
        test_id:$test_id,
        timestamp:$timestamp,
        status:$status,
        provenance:$provenance,
        elapsed_s:($avg_elapsed|tonumber),
        detail:$detail,
        runs:$runs,
        case_total:($case_total|tonumber),
        case_pass:($case_pass|tonumber),
        case_fail:($case_fail|tonumber),
        case_skip:($case_skip|tonumber)
      }' > "$json_file"

    jq -c '.' "$json_file" >> "$RESULTS_DIR/history/${test_id}.jsonl"
    record_eta "$test_id" "$avg_elapsed"

    rm -f "$run_metrics_tmp"
    return $exit_code
}
export -f run_script_internal

# === Argument Parsing ===
PARAMS=()
while (( "$#" )); do
  case "$1" in
    --parallel=*) PARALLEL="${1#*=}"; shift ;;
    --benchmark) BENCHMARK=true; shift ;;
    --jfr) JFR=true; shift ;;
    --profile=*) PROFILE="${1#*=}"; shift ;;
    --preset=*) PRESET="${1#*=}"; shift ;;
    --flash) PRESET="flash"; shift ;;
    --fast) PRESET="fast"; shift ;;
    --slow) PRESET="slow"; shift ;;
    --print-timeout) PRINT_TIMEOUT=true; shift ;;
    -h|--help) usage ;;
    *) PARAMS+=("$1"); shift ;;
  esac
done

if [[ ${#PARAMS[@]} -eq 0 ]]; then usage; fi

apply_preset

# === Discovery ===
TEST_LIST=()
declare -A SKIP_REASON_DISCOVERY=()
load_registry_rows
for TARGET in "${PARAMS[@]}"; do
    add_tests_for_target "$TARGET"
done

# Deduplicate tests while preserving order.
if [[ ${#TEST_LIST[@]} -gt 0 ]]; then
    declare -A __SEEN_TESTS=()
    UNIQUE_TEST_LIST=()
    for script in "${TEST_LIST[@]}"; do
        if [[ -z "${__SEEN_TESTS[$script]+x}" ]]; then
            __SEEN_TESTS[$script]=1
            UNIQUE_TEST_LIST+=("$script")
        fi
    done
    TEST_LIST=("${UNIQUE_TEST_LIST[@]}")
fi

TOTAL_COUNT=${#TEST_LIST[@]}
if [[ "$TOTAL_COUNT" -eq 0 ]]; then
    echo "No tests found for targets: ${PARAMS[*]}"
    exit 1
fi

load_production_pipelines
if ! validate_pipeline_prefixes; then
    echo "Prefix lint failed. Synthetic pipelines in tests must use test-/bench- prefixes." >&2
    exit 1
fi

if [[ "${PRINT_TIMEOUT:-false}" == "true" ]]; then
    for script_path in "${TEST_LIST[@]}"; do
        test_id=$(test_id_for_script "$script_path")
        timeout_val=$( (grep '^# @timeout:' "$script_path" || true) | cut -d':' -f2- | sed 's/[^0-9]//g')
        [[ -z "$timeout_val" ]] && timeout_val=60
        if [[ "$PER_TEST_TIMEOUT_CAP" -gt 0 && "$timeout_val" -gt "$PER_TEST_TIMEOUT_CAP" ]]; then
            timeout_val="$PER_TEST_TIMEOUT_CAP"
        fi
        echo "${test_id}: ${timeout_val}s"
    done
    exit 0
fi

# === Execution ===
START_SUITE_TIME=$(date +%s)
ESTIMATED_TOTAL_TIME=0
for script in "${TEST_LIST[@]}"; do
    ESTIMATED_TOTAL_TIME=$(echo "$ESTIMATED_TOTAL_TIME + $(get_eta "$(test_id_for_script "$script")")" | bc)
done

echo "Starting test suite: ${PARAMS[*]} ($TOTAL_COUNT tests, Preset: $PRESET, Estimated time: $(format_duration "$ESTIMATED_TOTAL_TIME"))"
if [[ ${#DISCOVERY_SKIP_LINES[@]} -gt 0 ]]; then
    for skip_line in "${DISCOVERY_SKIP_LINES[@]}"; do
        [[ "$INTERACTIVE" == "false" ]] && echo "$skip_line"
    done
fi

OK_COUNT=0
NOK_COUNT=0
CURRENT_COUNT=0
ABORTED_BY_BUDGET=false

if [[ "$PARALLEL" -gt 1 ]]; then
    log "Running with $PARALLEL parallel jobs"
    export -f run_script_internal test_id_for_script infer_provenance
    printf "%s\n" "${TEST_LIST[@]}" | parallel -j "$PARALLEL" --bar "tid=\$(test_id_for_script {}); runs=\$(grep '^# @runs:' {} | cut -d':' -f2- | sed 's/^ *//' || echo 1); [[ -z \$runs ]] && runs=1; prov=\$(infer_provenance {}); run_script_internal {} \$tid \$runs \$prov"
else
    for script in "${TEST_LIST[@]}"; do
        CURRENT_COUNT=$((CURRENT_COUNT + 1))
        test_id=$(test_id_for_script "$script")
        runs=$( (grep '^# @runs:' "$script" || true) | cut -d':' -f2- | sed 's/^ *//')
        [[ -z "$runs" ]] && runs=1
        provenance=$(infer_provenance "$script")

        pct=$((CURRENT_COUNT * 100 / TOTAL_COUNT))
        elapsed_now=$(($(date +%s) - START_SUITE_TIME))
        remaining_time=$(echo "$ESTIMATED_TOTAL_TIME - $elapsed_now" | bc)
        [[ $(echo "$remaining_time < 0" | bc) -eq 1 ]] && remaining_time=0

        if [[ "$INTERACTIVE" == "true" ]]; then
            printf "\r[%s] TOTAL %d OK:%d (%d%%) NOK:%d | DONE %d%% (%d/%d) ETA %s" \
                "${PARAMS[*]}" "$TOTAL_COUNT" "$OK_COUNT" "$(( (OK_COUNT+NOK_COUNT) > 0 ? OK_COUNT * 100 / (OK_COUNT + NOK_COUNT) : 0))" \
                "$NOK_COUNT" "$pct" "$CURRENT_COUNT" "$TOTAL_COUNT" "$(format_duration "$remaining_time")"
        fi

        if run_script_internal "$script" "$test_id" "$runs" "$provenance"; then
            script_status=$(jq -r '.status // "OK"' "$CURRENT_RESULTS_DIR/${test_id}.json" 2>/dev/null || echo "OK")
            if [[ "$script_status" == "SKIP" ]]; then
                [[ "$INTERACTIVE" == "false" ]] && echo "[ SKIP ][${provenance}] $test_id"
            else
                OK_COUNT=$((OK_COUNT + 1))
                [[ "$INTERACTIVE" == "false" ]] && echo "[ PASS ][${provenance}] $test_id"
            fi
        else
            NOK_COUNT=$((NOK_COUNT + 1))
            [[ "$INTERACTIVE" == "false" ]] && echo "[ FAIL ][${provenance}] $test_id"
        fi

        if [[ "$SUITE_MAX_SECONDS" -gt 0 ]]; then
            elapsed_now=$(($(date +%s) - START_SUITE_TIME))
            if [[ "$elapsed_now" -ge "$SUITE_MAX_SECONDS" ]]; then
                ABORTED_BY_BUDGET=true
                echo ""
                echo "Suite budget exceeded for preset '$PRESET' (${SUITE_MAX_SECONDS}s). Stopping early."
                break
            fi
        fi
    done
fi

# Final summary collection
OK_COUNT=0
NOK_COUNT=0
SKIP_COUNT=0
CASE_TOTAL=0
CASE_PASS=0
CASE_FAIL=0
CASE_SKIP=0
ACTUAL_COUNT=0
TEST_PIPE_COUNT=0
BENCH_PIPE_COUNT=0
MIXED_PIPE_COUNT=0
declare -A SKIP_REASON_CASES=()

for f in "$CURRENT_RESULTS_DIR"/*.json; do
    if [[ -f "$f" ]]; then
        status=$(jq -r '.status' "$f")
        provenance=$(jq -r '.provenance // "actual"' "$f")
        c_total=$(jq -r '.case_total // 0' "$f")
        c_pass=$(jq -r '.case_pass // 0' "$f")
        c_fail=$(jq -r '.case_fail // 0' "$f")
        c_skip=$(jq -r '.case_skip // 0' "$f")

        [[ "$status" == "OK" ]] && OK_COUNT=$((OK_COUNT+1))
        [[ "$status" == "NOK" ]] && NOK_COUNT=$((NOK_COUNT+1))
        [[ "$status" == "SKIP" ]] && SKIP_COUNT=$((SKIP_COUNT+1))

        CASE_TOTAL=$((CASE_TOTAL + c_total))
        CASE_PASS=$((CASE_PASS + c_pass))
        CASE_FAIL=$((CASE_FAIL + c_fail))
        CASE_SKIP=$((CASE_SKIP + c_skip))

        while IFS='|' read -r reason rcount; do
            [[ -z "${reason:-}" ]] && continue
            [[ -z "${rcount:-}" ]] && continue
            SKIP_REASON_CASES["$reason"]=$(( ${SKIP_REASON_CASES["$reason"]:-0} + rcount ))
        done < <(jq -r '
            [
              .runs[]?.cases[]?
              | select(.status=="SKIP")
              | (.detail // "")
              | if test("reason=")
                then (capture("reason=(?<r>[^,; ]+)").r // "unspecified")
                else (if length > 0 then . else "unspecified" end)
                end
            ]
            | group_by(.)
            | map([.[0], (length|tostring)] | join("|"))
            | .[]
        ' "$f")

        case "$provenance" in
            actual) ACTUAL_COUNT=$((ACTUAL_COUNT+1)) ;;
            test) TEST_PIPE_COUNT=$((TEST_PIPE_COUNT+1)) ;;
            bench) BENCH_PIPE_COUNT=$((BENCH_PIPE_COUNT+1)) ;;
            mixed) MIXED_PIPE_COUNT=$((MIXED_PIPE_COUNT+1)) ;;
        esac
    fi
done

TOTAL_ELAPSED=$(($(date +%s) - START_SUITE_TIME))

echo ""
echo ""
echo "=========================================================="
echo "[SUMMARY] SCRIPTS TOTAL: $TOTAL_COUNT  OK: $OK_COUNT  NOK: $NOK_COUNT  SKIP: $SKIP_COUNT"
if [[ ${#DISCOVERY_SKIP_LINES[@]} -gt 0 ]]; then
    echo "[SUMMARY] DISCOVERY-SKIP: ${#DISCOVERY_SKIP_LINES[@]}"
fi
echo "[SUMMARY] CASES   TOTAL: $CASE_TOTAL  PASS: $CASE_PASS  FAIL: $CASE_FAIL  SKIP: $CASE_SKIP"
echo "[SUMMARY] PROVENANCE actual=$ACTUAL_COUNT test=$TEST_PIPE_COUNT bench=$BENCH_PIPE_COUNT mixed=$MIXED_PIPE_COUNT"
if [[ ${#SKIP_REASON_DISCOVERY[@]} -gt 0 || ${#SKIP_REASON_CASES[@]} -gt 0 ]]; then
    skip_bits=()
    for reason in "${!SKIP_REASON_DISCOVERY[@]}"; do
        skip_bits+=("$reason=${SKIP_REASON_DISCOVERY[$reason]}")
    done
    for reason in "${!SKIP_REASON_CASES[@]}"; do
        skip_bits+=("$reason=${SKIP_REASON_CASES[$reason]}")
    done
    echo "[SUMMARY] SKIP-REASONS ${skip_bits[*]}"
fi
echo "Time: ${TOTAL_ELAPSED}s"
if [[ "$ABORTED_BY_BUDGET" == "true" ]]; then
    echo "Budget stop: preset '$PRESET' limit reached"
fi
echo "=========================================================="

if [[ "$BENCHMARK" == "true" ]]; then
    echo "BENCHMARK STATISTICS"
    echo "----------------------------------------------------------"
    printf "%-30s %-10s %-10s %-10s %-10s\n" "Test ID" "Min" "Max" "Avg" "StdDev"
    for json in "$CURRENT_RESULTS_DIR"/*.json; do
        if [[ -f "$json" ]]; then
            test_id=$(basename "$json" .json)
            vals=$(jq -r '.detail' "$json" | grep -oP 'throughput=\K[0-9.]+' | tr '\n' ',' | sed 's/,$//')
            if [[ -n "$vals" ]]; then
                awk -F',' -v tid="$test_id" '
                {
                    sum=0; min=999999; max=0; n=NF;
                    for(i=1;i<=NF;i++) {
                        v=$i; sum+=v; if(v<min) min=v; if(v>max) max=v;
                    }
                    avg=sum/n;
                    ss=0; for(i=1;i<=NF;i++) ss+=(($i-avg)^2);
                    std=sqrt(ss/n);
                    printf "%-30s %-10.2f %-10.2f %-10.2f %-10.2f\n", tid, min, max, avg, std;
                }' <<< "$vals"
            fi
        fi
    done
    echo "----------------------------------------------------------"

    if [[ -f "$MODULE_BENCH_REPORT" ]]; then
        echo "MODULE SYNTHETIC BENCHMARKS"
        echo "----------------------------------------------------------"
        printf "%-30s %-24s %-12s %-10s\n" "Script" "Module" "Value" "Unit"
        awk -F'\t' '{ printf "%-30s %-24s %-12s %-10s\n", $1, $2, $3, $4 }' "$MODULE_BENCH_REPORT"
        echo "----------------------------------------------------------"
    fi
fi

popd > /dev/null
[[ "$NOK_COUNT" -gt 0 || "$ABORTED_BY_BUDGET" == "true" ]] && exit 1 || exit 0
